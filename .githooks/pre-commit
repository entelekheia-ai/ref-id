#!/usr/bin/env bash
# pre-commit — run the governance gate before a commit is allowed to land.
#
# Wiring only, no check logic: the checks are the ones `vibe-ops check` composes — its built-ins, plus this
# repository's own gates under .vibe-ops/, named by vibeops.config.ts. To run the identical thing by hand
# without committing: `vibe-ops check` (and `vibe-ops check --self-test` for the fixtures).
#
# There is no shell runner between this hook and the CLI. One existed to compose shell fragments the CLI
# could not find on its own; this repository holds none, so the bare command composes exactly what the
# runner did. What the runner did that was not a workaround is here: the refusal when the CLI is missing,
# and printing only what asks for action.
#
# `set -e` is deliberately absent: the gate's exit code is captured, never propagated by accident.
#
# SILENT ON SUCCESS. The gate prints a banner, its composition, and one line per passing or skipped check —
# none of which asks for an action. The expensive reader is not the terminal but the agent: a commit made
# through a tool call puts every one of those lines into a conversation, on every commit. So a clean run
# prints only its warnings, and a failure only what failed. GATE_VERBOSE=1 gets the full run back.
#
# To skip once: git commit --no-verify. Wired via `git config core.hooksPath .githooks` — that setting is
# local and does not travel with a clone, so a tracked hook nobody wired is still silently absent.
set -uo pipefail

ROOT=$(git rev-parse --show-toplevel)

# THE GATE IS `vibe-ops` ON PATH, AND THERE IS NO FALLBACK. A gate that silently passes because its
# checker is missing is worse than one that refuses — so a machine without the CLI cannot commit here
# until it installs it, or says so with --no-verify.
if ! command -v vibe-ops >/dev/null 2>&1; then
  cat >&2 <<'EOF'
pre-commit: no `vibe-ops` on PATH — this repository's gate cannot run.
The governance checks, including the specification's own gates under .vibe-ops/, are composed by the
vibe-ops CLI, so the CLI is required to commit here. Install it with:
  npm i -g @entelekheia/vibe-ops-cli
EOF
  exit 2
fi

# A destination for the reading taken at *this* attempt, whether or not the commit that follows is
# allowed to happen — which is the whole reason "attempt" is the moment a gate measures. Per-clone and
# .git/-relative: neither shared nor meant to travel. Never set for a manual `vibe-ops check`: the
# population this feeds is commit attempts, and a manual run backs none.
GIT_DIR=$(git rev-parse --git-dir)
export GATE_ARTIFACT_DIR="$GIT_DIR/gate-artifacts"
mkdir -p "$GATE_ARTIFACT_DIR"

# The gates' own fixtures, when and only when a gate or its composition changed. A gate cannot stop
# detecting on its own — staging one is the only moment its answer can change.
if git diff --cached --name-only --diff-filter=ACMRD | grep -q '^\.vibe-ops/\|^vibeops\.config\.'; then
  if ! SELF_TEST=$(vibe-ops check --self-test "$ROOT" 2>&1); then
    echo "pre-commit: a gate stopped firing on its own fixture — commit refused." >&2
    printf '%s\n' "$SELF_TEST" | grep -E '^FAIL ' >&2 || printf '%s\n' "$SELF_TEST" >&2
    exit 1
  fi
fi

# --verbose, and it is load-bearing: without it the CLI filters its own output and drops the
# `N checks, M failed` line, so a run could say nothing whether or not it ran. The output is captured and
# filtered here instead, so asking for the full run costs the reader nothing.
OUTPUT=$(vibe-ops check --verbose "$ROOT" 2>&1)
RC=$?

if [ "${GATE_VERBOSE:-}" = "1" ]; then
  printf '%s\n' "$OUTPUT"
  exit "$RC"
fi

# A failing run prints its FAIL and WARN lines and nothing else. A refusal with no FAIL line — the gate
# itself could not run, a unit did not resolve — falls through to the whole message, which is correct:
# there the message is the finding.
if [ "$RC" -ne 0 ]; then
  printf '%s\n' "$OUTPUT" | grep -E '^(FAIL|WARN) ' || printf '%s\n' "$OUTPUT"
  exit "$RC"
fi

printf '%s\n' "$OUTPUT" | grep -E '^WARN ' || true
exit 0
