{
  "name": "ref-id",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "license": "Apache-2.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:grammar": "python3 spec/conformance/grammar-check.py && perl spec/conformance/grammar-check.pl",
    "test:relate": "node scripts/check-relate.mjs",
    "test:openrpc": "node scripts/check-openrpc.mjs",
    "test:surface": "node scripts/check-surface.mjs",
    "gen:spec": "node scripts/gen-spec.mjs",
    "release": "npm run build && changeset publish",
    "version": "changeset version && sh scripts/sync-versions.sh",
    "pretest:differential": "npm run build --workspace @entelekheia/ref-id",
    "test:differential": "node --experimental-strip-types scripts/differential.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@json-schema-tools/meta-schema": "^1.8.0",
    "@open-rpc/meta-schema": "^1.14.9",
    "@types/node": "^25.2.3",
    "ajv": "^8.20.0",
    "tree-sitter-rust": "^0.24.0",
    "typescript": "^7.0.2",
    "web-tree-sitter": "^0.27.0"
  }
}
