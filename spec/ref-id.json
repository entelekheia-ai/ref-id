{
  "specVersion": "1.0.0",
  "scheme": "ref",
  "grammar": {
    "dialect": "ecmascript-2018",
    "expression": "^ref:(?:(?<version>[0-9]+):)?(?<type>[a-z][a-z0-9+.-]*):(?<locator>[^;#]+)(?:;(?<state>[^#]*))?(?:#(?<fragment>.*))?$",
    "groups": [
      "version",
      "type",
      "locator",
      "state",
      "fragment"
    ],
    "adaptations": {
      "ecmascript-2018": {
        "replace": []
      },
      "pcre2": {
        "replace": []
      },
      "rust-regex": {
        "replace": []
      },
      "python-re": {
        "replace": [
          [
            "(?<",
            "(?P<"
          ]
        ]
      }
    },
    "state": {
      "separator": ";",
      "pair": "^(?<key>[a-z][a-z0-9-]*)=(?<value>.*)$",
      "unknownKey": "carry-through"
    },
    "fragment": {
      "separator": ";",
      "pair": "^(?<key>[a-z][a-z0-9-]*)=(?<value>.*)$",
      "path": "the text before the first separator, verbatim"
    }
  },
  "version": {
    "default": 1,
    "supported": [
      1
    ],
    "mints": [
      "normalisation or percent-encoding",
      "separators or shape"
    ],
    "note": "A leading digit can only be a version because a type starts with a letter; ref:v2:... is type v2."
  },
  "encoding": {
    "locator": {
      "reserved": [
        "#"
      ],
      "table": {
        "#": "%23"
      },
      "decodeBeforeDelegation": true
    },
    "nested": {
      "reserved": [
        ";",
        "#",
        "%"
      ],
      "table": {
        ";": "%3B",
        "#": "%23",
        "%": "%25"
      },
      "depth": 1
    }
  },
  "dispatch": {
    "pkg": {
      "locator": "package-url",
      "validator": "package-url",
      "delegate": "type-prefixed",
      "reference": "https://github.com/package-url/purl-spec"
    },
    "folder": {
      "locator": "declared-corpus-name",
      "validator": "declared-name",
      "delegate": "verbatim",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "declaredBy": "one line in the repository configuration, per subtree, nearest ancestor wins"
    }
  },
  "delegation": {
    "type-prefixed": "the validator receives <type>:<decoded locator> — the type token is also the delegated format's own scheme",
    "verbatim": "the validator receives the decoded locator alone"
  },
  "statuses": [
    "ok",
    "malformed",
    "uncovered",
    "unsupported"
  ],
  "parts": [
    "grammar",
    "state",
    "fragment",
    "locator",
    "<qualifier key>",
    "<refinement key>"
  ],
  "unknownType": "uncovered",
  "roles": {
    "identity": [
      "type",
      "locator",
      "fragment.path"
    ],
    "location": [
      "path",
      "byte range"
    ],
    "freeze": [
      "at"
    ]
  },
  "qualifiers": {
    "at": {
      "role": "freeze",
      "forms": [
        "swhid"
      ]
    },
    "by": {
      "role": "instrument",
      "forms": [
        "ref",
        "sha256"
      ]
    },
    "over": {
      "role": "population",
      "forms": [
        "ref",
        "sha256"
      ]
    }
  },
  "forms": {
    "swhid": {
      "pattern": "^swh:1:(cnt|dir|rev|rel|snp):[0-9a-f]{40}$",
      "reference": "ISO/IEC 18670 core identifier, no SWHID qualifiers"
    },
    "sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "ref": {
      "nested": true,
      "depth": 1,
      "encoding": "nested"
    }
  },
  "refinements": {
    "lines": {
      "pattern": "^[0-9]+(,[0-9]+)?$",
      "reference": "RFC 5147 placement"
    },
    "item": {
      "pattern": "^[0-9]+$"
    },
    "para": {
      "pattern": "^[0-9]+$"
    }
  },
  "unknownRefinement": "carry-through",
  "resolutionStates": [
    "resolved",
    "unresolved",
    "uncovered",
    "archival"
  ],
  "stateLevels": [
    "properties",
    "content-hash",
    "none"
  ],
  "fragmentGrammars": {
    "governed-record": {
      "declaredName": "the name field of its front matter",
      "tieBreak": "none"
    },
    "markdown": {
      "declaredName": "the heading text",
      "tieBreak": "ordinal on collision within one document"
    },
    "code-symbol": {
      "declaredName": "the fully-qualified name, no path",
      "tieBreak": "per the language"
    },
    "behavior-state": {
      "declaredName": "the state name within its agent, never within its file",
      "tieBreak": "none"
    }
  },
  "digest": {
    "algorithm": "sha256",
    "over": "identifier-strings",
    "order": "declared",
    "join": "\n",
    "encoding": "utf-8",
    "dedupe": false,
    "output": "sha256:<64 lowercase hex>"
  },
  "canonicalisation": {
    "form": "json-sorted-keys-compact",
    "rules": [
      "object keys sorted by UTF-16 code unit order",
      "no whitespace outside strings",
      "strings escaped as JSON.stringify does",
      "numbers are integers only",
      "UTF-8 bytes of the result are what the digest covers"
    ],
    "sidecar": "ref-id.json.sha256 holds the digest of this file; the file never contains its own digest"
  },
  "envelope": {
    "fields": {
      "id": "required",
      "sets": "required when the identifier carries a digest",
      "alsoKnownAs": "optional, a declaration never a similarity match",
      "data": "opaque"
    },
    "invariant": "for every qualifier whose value is a digest, sets[qualifier] exists and digest(sets[qualifier]) equals it; and id equals the identifier the envelope was requested under",
    "onFailure": "refuse at ingestion"
  },
  "vectors": {
    "parse": [
      {
        "name": "pkg with declared name",
        "input": "ref:pkg:npm/@acme/scanner-core@0.1.0#Observation",
        "expect": {
          "status": "ok",
          "version": 1,
          "qualifiers": [],
          "fragment": {
            "path": "Observation",
            "refinements": []
          },
          "type": "pkg",
          "locator": "npm/@acme/scanner-core@0.1.0",
          "delegated": "pkg:npm/@acme/scanner-core@0.1.0"
        }
      },
      {
        "name": "pkg with versioned declared-name path",
        "input": "ref:pkg:npm/@acme/trait-citation-fidelity@0.0.1#citation-fidelity@1/not-invented",
        "expect": {
          "status": "ok",
          "version": 1,
          "qualifiers": [],
          "fragment": {
            "path": "citation-fidelity@1/not-invented",
            "refinements": []
          },
          "type": "pkg",
          "locator": "npm/@acme/trait-citation-fidelity@0.0.1"
        }
      },
      {
        "name": "folder corpus with declared name",
        "input": "ref:folder:acme-governance#learnings/a-chunk-carrying-no-answer-means-death-or-health",
        "expect": {
          "status": "ok",
          "version": 1,
          "qualifiers": [],
          "fragment": {
            "path": "learnings/a-chunk-carrying-no-answer-means-death-or-health",
            "refinements": []
          },
          "type": "folder",
          "locator": "acme-governance"
        }
      },
      {
        "name": "folder with at and by digest",
        "input": "ref:folder:acme-tools;at=swh:1:rev:7e29bb6000000000000000000000000000000000;by=sha256:41b9caaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "expect": {
          "status": "ok",
          "version": 1,
          "qualifiers": [
            [
              "at",
              "swh:1:rev:7e29bb6000000000000000000000000000000000"
            ],
            [
              "by",
              "sha256:41b9caaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
            ]
          ],
          "fragment": null,
          "type": "folder",
          "locator": "acme-tools"
        }
      },
      {
        "name": "explicit version 1 is version 1",
        "input": "ref:1:pkg:npm/x@1.0.0",
        "expect": {
          "status": "ok",
          "version": 1,
          "qualifiers": [],
          "fragment": null,
          "type": "pkg",
          "locator": "npm/x@1.0.0",
          "delegated": "pkg:npm/x@1.0.0",
          "explicitVersion": true
        }
      },
      {
        "name": "version outside the supported range is unsupported, not malformed",
        "input": "ref:2:pkg:npm/x@1.0.0",
        "expect": {
          "status": "unsupported",
          "version": 2,
          "type": "pkg",
          "locator": "npm/x@1.0.0"
        }
      },
      {
        "name": "letter-led token is a type, not a version",
        "input": "ref:v2:pkg:npm/x",
        "expect": {
          "status": "uncovered",
          "version": 1,
          "type": "v2",
          "locator": "pkg:npm/x"
        }
      },
      {
        "name": "unknown type is uncovered, never an exception",
        "input": "ref:doi:10.1000/182",
        "expect": {
          "status": "uncovered",
          "version": 1,
          "type": "doi",
          "locator": "10.1000/182"
        }
      },
      {
        "name": "unknown qualifier key is carried through",
        "input": "ref:folder:acme-tools;zz=1;at=swh:1:rev:7e29bb6000000000000000000000000000000000",
        "expect": {
          "status": "ok",
          "version": 1,
          "qualifiers": [
            [
              "zz",
              "1"
            ],
            [
              "at",
              "swh:1:rev:7e29bb6000000000000000000000000000000000"
            ]
          ],
          "fragment": null,
          "type": "folder",
          "locator": "acme-tools"
        }
      },
      {
        "name": "nested by carrying a fragment",
        "input": "ref:folder:acme-tools;by=ref:pkg:npm/@acme/profiles@0.1.0%23profile/conformance@1",
        "expect": {
          "status": "ok",
          "version": 1,
          "qualifiers": [
            [
              "by",
              "ref:pkg:npm/@acme/profiles@0.1.0%23profile/conformance@1"
            ]
          ],
          "fragment": null,
          "type": "folder",
          "locator": "acme-tools",
          "nested": {
            "by": "ref:pkg:npm/@acme/profiles@0.1.0#profile/conformance@1"
          }
        }
      },
      {
        "name": "nested by carrying its own qualifier",
        "input": "ref:folder:acme-tools;by=ref:pkg:npm/x@1.0.0%3Bat=swh:1:rev:7e29bb6000000000000000000000000000000000%23S",
        "expect": {
          "status": "ok",
          "version": 1,
          "qualifiers": [
            [
              "by",
              "ref:pkg:npm/x@1.0.0%3Bat=swh:1:rev:7e29bb6000000000000000000000000000000000%23S"
            ]
          ],
          "fragment": null,
          "type": "folder",
          "locator": "acme-tools",
          "nested": {
            "by": "ref:pkg:npm/x@1.0.0;at=swh:1:rev:7e29bb6000000000000000000000000000000000#S"
          }
        }
      },
      {
        "name": "two different nested values are two different identifiers",
        "input": "ref:folder:acme-tools;by=ref:pkg:npm/x@1.0.0%3Bat=swh:1:rev:7e29bb6000000000000000000000000000000000",
        "expect": {
          "status": "ok",
          "version": 1,
          "qualifiers": [
            [
              "by",
              "ref:pkg:npm/x@1.0.0%3Bat=swh:1:rev:7e29bb6000000000000000000000000000000000"
            ]
          ],
          "fragment": null,
          "type": "folder",
          "locator": "acme-tools",
          "nested": {
            "by": "ref:pkg:npm/x@1.0.0;at=swh:1:rev:7e29bb6000000000000000000000000000000000"
          }
        }
      },
      {
        "name": "purl subpath is percent-encoded inside the locator",
        "input": "ref:pkg:npm/x@1.0.0%23src/y#S",
        "expect": {
          "status": "ok",
          "version": 1,
          "qualifiers": [],
          "fragment": {
            "path": "S",
            "refinements": []
          },
          "type": "pkg",
          "locator": "npm/x@1.0.0%23src/y",
          "delegated": "pkg:npm/x@1.0.0#src/y"
        }
      },
      {
        "name": "refinement after the declared-name path",
        "input": "ref:folder:acme-tools#AGENTS.md;lines=10,20",
        "expect": {
          "status": "ok",
          "version": 1,
          "qualifiers": [],
          "fragment": {
            "path": "AGENTS.md",
            "refinements": [
              [
                "lines",
                "10,20"
              ]
            ]
          },
          "type": "folder",
          "locator": "acme-tools"
        }
      },
      {
        "name": "qualifier before the hash, refinement after it",
        "input": "ref:folder:acme-tools;at=swh:1:cnt:3404a00f00000000000000000000000000000000#AGENTS.md;lines=1",
        "expect": {
          "status": "ok",
          "version": 1,
          "qualifiers": [
            [
              "at",
              "swh:1:cnt:3404a00f00000000000000000000000000000000"
            ]
          ],
          "fragment": {
            "path": "AGENTS.md",
            "refinements": [
              [
                "lines",
                "1"
              ]
            ]
          },
          "type": "folder",
          "locator": "acme-tools"
        }
      },
      {
        "name": "unknown refinement key is carried through",
        "input": "ref:folder:acme-tools#AGENTS.md;zz=q",
        "expect": {
          "status": "ok",
          "version": 1,
          "qualifiers": [],
          "fragment": {
            "path": "AGENTS.md",
            "refinements": [
              [
                "zz",
                "q"
              ]
            ]
          },
          "type": "folder",
          "locator": "acme-tools"
        }
      },
      {
        "name": "over as a digest",
        "input": "ref:folder:acme-tools;over=sha256:41b9caaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "expect": {
          "status": "ok",
          "version": 1,
          "qualifiers": [
            [
              "over",
              "sha256:41b9caaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
            ]
          ],
          "fragment": null,
          "type": "folder",
          "locator": "acme-tools"
        }
      },
      {
        "name": "a validator failure outranks an unknown type",
        "input": "ref:doi:10.1000/182;at=swh:1:rev:7e29bb6",
        "expect": {
          "status": "malformed",
          "part": "at"
        }
      },
      {
        "name": "an unsupported version is not validated further",
        "input": "ref:2:pkg:npm/x@1.0.0;at=swh:1:rev:7e29bb6",
        "expect": {
          "status": "unsupported",
          "version": 2,
          "type": "pkg",
          "locator": "npm/x@1.0.0",
          "qualifiers": [
            [
              "at",
              "swh:1:rev:7e29bb6"
            ]
          ]
        }
      },
      {
        "name": "an uncovered type still carries its qualifiers and fragment",
        "input": "ref:doi:10.1000/182;at=swh:1:rev:7e29bb6000000000000000000000000000000000#S",
        "expect": {
          "status": "uncovered",
          "version": 1,
          "type": "doi",
          "locator": "10.1000/182",
          "qualifiers": [
            [
              "at",
              "swh:1:rev:7e29bb6000000000000000000000000000000000"
            ]
          ],
          "fragment": {
            "path": "S",
            "refinements": []
          }
        }
      },
      {
        "name": "percent in a nested value is itself encoded",
        "input": "ref:folder:acme-tools;by=ref:pkg:npm/x@1.0.0%2523src/y",
        "expect": {
          "status": "ok",
          "version": 1,
          "qualifiers": [
            [
              "by",
              "ref:pkg:npm/x@1.0.0%2523src/y"
            ]
          ],
          "fragment": null,
          "type": "folder",
          "locator": "acme-tools",
          "nested": {
            "by": "ref:pkg:npm/x@1.0.0%23src/y"
          }
        }
      },
      {
        "name": "empty fragment is malformed",
        "input": "ref:folder:acme-tools#",
        "expect": {
          "status": "malformed",
          "part": "fragment"
        }
      },
      {
        "name": "empty qualifier is malformed",
        "input": "ref:folder:acme-tools;",
        "expect": {
          "status": "malformed",
          "part": "state"
        }
      },
      {
        "name": "qualifier without a value separator is malformed",
        "input": "ref:folder:acme-tools;at",
        "expect": {
          "status": "malformed",
          "part": "state"
        }
      },
      {
        "name": "a nested value that is not a ref and not a digest fails the by validator",
        "input": "ref:folder:acme-tools;by=rumdl",
        "expect": {
          "status": "malformed",
          "part": "by"
        }
      },
      {
        "name": "uppercase type is malformed",
        "input": "ref:Pkg:npm/x@1.0.0",
        "expect": {
          "status": "malformed",
          "part": "grammar"
        }
      },
      {
        "name": "missing scheme is malformed",
        "input": "pkg:npm/x@1.0.0",
        "expect": {
          "status": "malformed",
          "part": "grammar"
        }
      },
      {
        "name": "empty locator is malformed",
        "input": "ref:pkg:",
        "expect": {
          "status": "malformed",
          "part": "grammar"
        }
      },
      {
        "name": "abbreviated SWHID fails the at validator",
        "input": "ref:folder:acme-tools;at=swh:1:rev:7e29bb6",
        "expect": {
          "status": "malformed",
          "part": "at"
        }
      },
      {
        "name": "invalid purl fails the locator validator",
        "input": "ref:pkg:not-a-purl",
        "expect": {
          "status": "malformed",
          "part": "locator"
        }
      },
      {
        "name": "malformed refinement value",
        "input": "ref:folder:acme-tools#AGENTS.md;lines=ten",
        "expect": {
          "status": "malformed",
          "part": "lines"
        }
      },
      {
        "name": "corpus name with a path separator is malformed",
        "input": "ref:folder:acme-tools/docs#AGENTS.md",
        "expect": {
          "status": "malformed",
          "part": "locator"
        }
      }
    ],
    "roundtrip": [
      "ref:pkg:npm/@acme/scanner-core@0.1.0#Observation",
      "ref:1:pkg:npm/x@1.0.0",
      "ref:folder:acme-tools;zz=1;at=swh:1:rev:7e29bb6000000000000000000000000000000000",
      "ref:folder:acme-tools;by=ref:pkg:npm/@acme/profiles@0.1.0%23profile/conformance@1",
      "ref:folder:acme-tools;by=ref:pkg:npm/x@1.0.0%3Bat=swh:1:rev:7e29bb6000000000000000000000000000000000%23S",
      "ref:pkg:npm/x@1.0.0%23src/y#S",
      "ref:folder:acme-tools;at=swh:1:cnt:3404a00f00000000000000000000000000000000#AGENTS.md;lines=1",
      "ref:folder:acme-tools#AGENTS.md;zz=q",
      "ref:doi:10.1000/182",
      "ref:2:pkg:npm/x@1.0.0",
      "ref:doi:10.1000/182;at=swh:1:rev:7e29bb6000000000000000000000000000000000#S",
      "ref:folder:acme-tools;by=ref:pkg:npm/x@1.0.0%2523src/y"
    ],
    "build": [
      {
        "name": "same declared name through two paths is one identifier",
        "parts": {
          "type": "pkg",
          "locator": "npm/x@1.0.0",
          "fragment": "Observation",
          "location": {
            "path": "src/a.ts"
          }
        },
        "expect": "ref:pkg:npm/x@1.0.0#Observation"
      },
      {
        "name": "same declared name through two paths is one identifier (other path)",
        "parts": {
          "type": "pkg",
          "locator": "npm/x@1.0.0",
          "fragment": "Observation",
          "location": {
            "path": "lib/b.ts",
            "lines": "4,9"
          }
        },
        "expect": "ref:pkg:npm/x@1.0.0#Observation"
      },
      {
        "name": "nested qualifier value is encoded by the builder",
        "parts": {
          "type": "folder",
          "locator": "acme-tools",
          "qualifiers": [
            [
              "by",
              {
                "nested": "ref:pkg:npm/x@1.0.0;at=swh:1:rev:7e29bb6000000000000000000000000000000000#S"
              }
            ]
          ]
        },
        "expect": "ref:folder:acme-tools;by=ref:pkg:npm/x@1.0.0%3Bat=swh:1:rev:7e29bb6000000000000000000000000000000000%23S"
      },
      {
        "name": "a pkg locator given as the bare group builds as is",
        "parts": {
          "type": "pkg",
          "locator": "npm/x@1.0.0",
          "fragment": "Observation"
        },
        "expect": "ref:pkg:npm/x@1.0.0#Observation"
      },
      {
        "name": "an intact purl given as locator has its scheme folded into the type and its subpath encoded",
        "parts": {
          "type": "pkg",
          "locator": "pkg:npm/x@1.0.0#src/y",
          "fragment": "S"
        },
        "expect": "ref:pkg:npm/x@1.0.0%23src/y#S"
      }
    ],
    "digest": [
      {
        "name": "two members in declared order",
        "members": [
          "ref:folder:acme-tools#AGENTS.md;at=swh:1:cnt:3404a00f00000000000000000000000000000000",
          "ref:folder:acme-tools#GOVERNANCE.md;at=swh:1:cnt:48db124700000000000000000000000000000000"
        ],
        "expect": "sha256:97dbd730b42e5c3127486aff574dd40672eba5c411ac3ef680125ea452b6aaf8"
      },
      {
        "name": "same members, other order, different digest",
        "members": [
          "ref:folder:acme-tools#GOVERNANCE.md;at=swh:1:cnt:48db124700000000000000000000000000000000",
          "ref:folder:acme-tools#AGENTS.md;at=swh:1:cnt:3404a00f00000000000000000000000000000000"
        ],
        "expect": "sha256:eea8e9239a38d79d892ca4befe36ca9b4f8011a95ddad077c8b38d99f4126640"
      },
      {
        "name": "a repeated member is not deduplicated",
        "members": [
          "ref:folder:acme-tools#AGENTS.md;at=swh:1:cnt:3404a00f00000000000000000000000000000000",
          "ref:folder:acme-tools#AGENTS.md;at=swh:1:cnt:3404a00f00000000000000000000000000000000"
        ],
        "expect": "sha256:a743dc921954ceda107cca9e47ab74b701e9db15b41d0493331f1913f3742887"
      },
      {
        "name": "a single member",
        "members": [
